{
  "name": "messageweave",
  "version": "0.0.0",
  "description": "An in-process, database-agnostic, event-sourced messaging engine for TypeScript.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-jinu/messageweave.git",
    "directory": "packages/messageweave"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "test": "vitest",
    "lint:package": "publint",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./test": {
      "dev-source": "./src/test-utils/index.ts",
      "types": "./dist/test-utils/index.d.mts",
      "default": "./dist/test-utils/index.mjs"
    },
    "./schema": {
      "dev-source": "./src/schema.ts",
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./drizzle": {
      "dev-source": "./src/adapters/drizzle.ts",
      "types": "./dist/adapters/drizzle.d.mts",
      "default": "./dist/adapters/drizzle.mjs"
    },
    "./prisma": {
      "dev-source": "./src/adapters/prisma.ts",
      "types": "./dist/adapters/prisma.d.mts",
      "default": "./dist/adapters/prisma.mjs"
    },
    "./kysely": {
      "dev-source": "./src/adapters/kysely.ts",
      "types": "./dist/adapters/kysely.d.mts",
      "default": "./dist/adapters/kysely.mjs"
    },
    "./knex": {
      "dev-source": "./src/adapters/knex.ts",
      "types": "./dist/adapters/knex.d.mts",
      "default": "./dist/adapters/knex.mjs"
    },
    "./mongodb": {
      "dev-source": "./src/adapters/mongodb.ts",
      "types": "./dist/adapters/mongodb.d.mts",
      "default": "./dist/adapters/mongodb.mjs"
    },
    "./sumak": {
      "dev-source": "./src/adapters/sumak.ts",
      "types": "./dist/adapters/sumak.d.mts",
      "default": "./dist/adapters/sumak.mjs"
    }
  },
  "dependencies": {
    "unadapter": "^0.3.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@prisma/client": ">=6",
    "drizzle-orm": ">=0.40",
    "knex": ">=3",
    "kysely": ">=0.28",
    "mongodb": ">=6",
    "sumak": ">=0.0.16"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "sumak": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "drizzle-orm": "^0.45.2",
    "knex": "^3.2.10",
    "kysely": "^0.29.2",
    "mongodb": "^7.3.0",
    "sumak": "^0.0.16",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
