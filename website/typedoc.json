{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "tsconfig": "../packages/messageweave/tsconfig.json",
  "out": "docs/api",
  "cleanOutputDir": true,
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "entryFileName": "index",
  "fileExtension": ".md",
  "expandObjects": true,
  "useCodeBlocks": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "treatWarningsAsErrors": true,
  "requiredToBeDocumented": [
    "Variable",
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Property",
    "Method"
  ],
  "validation": {
    "invalidLink": true,
    "notDocumented": true,
    "notExported": true
  },
  "intentionallyNotExported": ["ChatCoreErrorConstructor"]
}
